@baseUrl = http://localhost:5000

### Register new tenant (Day 2) — expect 201 with token + tenantId
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "tenantName": "Initech",
  "adminUsername": "initech-admin",
  "adminEmail": "admin@initech.example",
  "adminPassword": "ChangeMe123!"
}

### Register duplicate username/email — expect 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "tenantName": "Initech Clone",
  "adminUsername": "initech-admin",
  "adminEmail": "other@initech.example",
  "adminPassword": "ChangeMe123!"
}

### Login as newly registered tenant admin
# @name registerLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "initech-admin",
  "password": "ChangeMe123!"
}

### Dashboard for registered tenant (Bearer from register)
GET {{baseUrl}}/api/dashboard
Authorization: Bearer {{register.response.body.$.token}}

### Login — valid credentials (seeded admin / password)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

### Login — invalid credentials (expect 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong-password"
}

### Protected tenants — WITHOUT Bearer token (expect 401 Unauthorized)
GET {{baseUrl}}/api/tenants

### Protected dashboard — WITHOUT Bearer token (expect 401 Unauthorized)
GET {{baseUrl}}/api/dashboard

### Protected tenants — WITH Bearer token (expect 200, tenant-isolated data)
GET {{baseUrl}}/api/tenants
Authorization: Bearer {{login.response.body.$.token}}

### Protected dashboard — WITH Bearer token (expect 200)
GET {{baseUrl}}/api/dashboard
Authorization: Bearer {{login.response.body.$.token}}

### Protected metrics — WITH Bearer token (expect 200)
GET {{baseUrl}}/api/metrics
Authorization: Bearer {{login.response.body.$.token}}

### Protected data — WITH Bearer token (expect 200, customers for current tenant only)
GET {{baseUrl}}/api/data
Authorization: Bearer {{login.response.body.$.token}}

### --- Day 4 Step 3: Rate limiting ---
### Rapid login attempts (auth policy: 10/min) — expect eventual 429
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong-password"
}

#
# Tip: repeat the request above >10 times within a minute from the same IP
# to observe HTTP 429 with {"message":"Too many requests. Please try again later."}
#
