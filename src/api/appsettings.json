{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://unified-saas-pipeline.vercel.app"
    ]
  },
  "Billing": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Maintenance": {
    "IntervalHours": 24,
    "SoftDeleteRetentionDays": 30,
    "PastDueGraceDays": 7,
    "StartupDelayMinutes": 1,
    "SystemApiKey": "local-dev-system-key"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyHereThatIsAtLeast32BytesLong!",
    "Issuer": "https://unified-saas-pipeline.onrender.com",
    "Audience": "https://unified-saas-pipeline.onrender.com"
  }
}
